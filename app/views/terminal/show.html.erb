<% content_for :title, Factory.app_name %>

<div class="flex-1 min-h-0 flex flex-col mx-1 sm:mx-6 my-1.5 sm:my-3 border border-line bg-panel-2 clip-tag">
  <div class="flex items-center gap-2 sm:gap-2.5 px-2 sm:px-3 py-1.5 sm:py-2 border-b border-line-soft text-xs shrink-0">
    <span class="dot" data-state="live"></span>
    <strong class="min-w-0 font-medium text-strong whitespace-nowrap overflow-hidden text-ellipsis">Claude</strong>
    <span class="flex items-center gap-1.5 shrink-0 ml-auto">
      <button id="mic" type="button" hidden title="Talk to Claude — hold to speak (or click, then hold SPACE)"
              class="text-[13px] leading-none px-2 py-1 clip-tag border border-idle/40 text-idle hover:bg-idle/10 cursor-pointer touch-none select-none data-[on=true]:text-danger data-[on=true]:border-danger/60 data-[on=true]:bg-danger/5">🎤</button>
      <button id="paste" type="button" hidden title="Paste from your clipboard"
              class="text-[13px] leading-none px-2 py-1 clip-tag border border-idle/40 text-idle hover:bg-idle/10 cursor-pointer">📋</button>
      <button id="notify" type="button" hidden title="Get pinged when Claude finishes"
              class="text-[13px] leading-none px-2 py-1 clip-tag border border-idle/40 text-idle hover:bg-idle/10 cursor-pointer">🔔</button>
      <a target="_blank" href="<%= Factory.preview_url(request.host) %>" title="Open the test version of your app"
         class="text-[10px] tracking-[0.14em] text-idle border border-idle/40 px-2.5 py-1 clip-tag hover:bg-idle/10">TRY IT ↗</a>
      <a target="_blank" href="/ui/" title="Pages Claude made for you"
         class="text-[10px] tracking-[0.14em] text-idle border border-idle/40 px-2.5 py-1 clip-tag hover:bg-idle/10">PAGES ↗</a>
    </span>
  </div>
  <div id="update-bar" hidden class="flex items-center gap-2 sm:gap-2.5 px-2 sm:px-3 py-1.5 sm:py-2 border-b border-line-soft text-xs shrink-0 bg-live/5">
    <span class="dot" data-state="live"></span>
    <span id="update-msg" class="min-w-0 flex-1 text-strong">A new version of Appsmoothly is ready.</span>
    <button id="update-go" type="button" title="Update the factory to the latest version"
            class="shrink-0 text-[10px] tracking-[0.14em] text-live border border-live/50 px-2.5 py-1 clip-tag hover:bg-live/10 cursor-pointer disabled:opacity-50">UPDATE ↑</button>
  </div>
  <div id="terminal" class="flex-1 min-h-0 overflow-hidden"></div>
</div>

<%# Claude's pop-up. It writes a page, calls the ask tool, and the box shows it
    here over the terminal — a form with big buttons instead of a paragraph
    asking a non-programmer to type a decision. What they fill in goes straight
    back to claude as that tool call's return value (see Ask + bin/mcp-ui). %>
<div id="ask-modal" hidden class="fixed inset-0 z-50 flex bg-ink/40 p-2 sm:p-6">
  <div class="m-auto w-full max-w-2xl h-full sm:h-[85dvh] flex flex-col bg-bg border border-strong/40 clip-tag overflow-hidden">
    <div class="flex items-center gap-2 px-3 py-2 border-b border-line-soft text-xs shrink-0 bg-panel">
      <span class="dot" data-state="live"></span>
      <strong id="ask-title" class="min-w-0 flex-1 truncate font-medium text-strong">Claude needs you</strong>
      <button id="ask-close" type="button" title="Close without answering"
              class="text-[13px] leading-none px-2 py-1 clip-tag border border-idle/40 text-idle hover:bg-idle/10 cursor-pointer">✕</button>
    </div>
    <iframe id="ask-frame" title="Claude's question" class="flex-1 w-full border-0 bg-bg"></iframe>
  </div>
</div>

<%= render "shared/terminal", token: @token %>

<%# Watch for a newer factory version and offer a one-tap update. The heavy work
    (pull, migrate, rebuild) and the service restart happen on the box; here we
    poll, then reload onto the new version once it's up. %>
<script type="module">
  const bar = document.getElementById("update-bar")
  const msg = document.getElementById("update-msg")
  const go  = document.getElementById("update-go")
  const CHECK = "<%= update_check_path %>"
  const csrf = document.querySelector('meta[name="csrf-token"]')?.content

  const poll = async () => {
    try {
      const r = await fetch(CHECK, { headers: { Accept: "application/json" }, cache: "no-store" })
      return r.ok ? await r.json() : null
    } catch { return null }               // server mid-restart, or offline
  }

  let applying = false
  const check = async () => {
    if (applying) return
    const s = await poll()
    if (s) bar.hidden = !s.available
  }

  go.addEventListener("click", async () => {
    if (applying) return
    applying = true
    go.disabled = true
    msg.textContent = "Updating… this page will reconnect in a moment."
    try {
      await fetch("<%= update_path %>", { method: "POST", headers: { "X-CSRF-Token": csrf } })
    } catch {}
    // Wait out the restart, then reload once the box is back on the new version.
    const started = Date.now()
    const wait = setInterval(async () => {
      const s = await poll()
      if (s && s.current && !s.available) { clearInterval(wait); location.reload() }
      else if (Date.now() - started > 5 * 60 * 1000) {
        clearInterval(wait)
        applying = false
        go.disabled = false
        msg.textContent = "Update didn't finish — ask Claude in the terminal to check bin/update."
      }
    }, 3000)
  })

  check()
  setInterval(check, 5 * 60 * 1000)
</script>

<%# Web Push: register the service worker and, once notifications are allowed,
    subscribe so the box can ping this browser when Claude finishes a turn. On
    iOS this only works from a Home-Screen install (its own permission store),
    which is why permission is (re)requested here via the 🔔 button. %>
<script type="module">
  const VAPID = "<%= Push.public_key %>"
  const csrf = document.querySelector('meta[name="csrf-token"]')?.content
  const notifyBtn = document.getElementById("notify")

  const b64ToBytes = (s) => {
    const pad = "=".repeat((4 - (s.length % 4)) % 4)
    const raw = atob((s + pad).replace(/-/g, "+").replace(/_/g, "/"))
    return Uint8Array.from(raw, (c) => c.charCodeAt(0))
  }

  const supported = "serviceWorker" in navigator && "PushManager" in window && "Notification" in window

  async function subscribe(reg) {
    const sub = await reg.pushManager.getSubscription()
           || await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: b64ToBytes(VAPID) })
    await fetch("<%= push_subscribe_path %>", {
      method: "POST",
      headers: { "Content-Type": "application/json", "X-CSRF-Token": csrf },
      body: JSON.stringify({ subscription: sub })
    })
    window.__pushActive = true                 // the terminal's own bell handler backs off
    notifyBtn.hidden = true
  }

  async function setup() {
    if (!supported) return
    let reg
    try { reg = await navigator.serviceWorker.register("<%= pwa_service_worker_path %>") } catch { return }
    if (Notification.permission === "granted") { try { await subscribe(reg) } catch {} ; return }
    if (Notification.permission === "denied") return
    notifyBtn.hidden = false                    // ask on tap (must be a user gesture)
    notifyBtn.addEventListener("click", async () => {
      try {
        if (await Notification.requestPermission() === "granted") await subscribe(reg)
      } catch {}
    })
  }
  setup()
</script>

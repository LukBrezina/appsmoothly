<%# Browser terminal attached to the tmux session named by the signed token.
    xterm is vendored (vendor/javascript) — this page mints a shell-capability
    token, so no third-party JS. Render into a container with id "terminal". %>
<% content_for :head do %>
  <link rel="stylesheet" href="<%= asset_path("xterm.min.css") %>">
  <script src="<%= asset_path("xterm.min.js") %>"></script>
  <script src="<%= asset_path("addon-fit.min.js") %>"></script>
<% end %>

<script type="module">
  import { createConsumer } from "@rails/actioncable"

  // Smaller type on phones fits more columns into the narrow screen.
  const fontSize = matchMedia("(max-width: 640px)").matches ? 11 : 13
  await document.fonts.load(`${fontSize}px "IBM Plex Mono"`) // xterm measures glyphs at open()

  const term = new Terminal({
    fontSize,
    fontFamily: '"IBM Plex Mono", ui-monospace, monospace',
    theme: {
      background: "#efe9dc", foreground: "#4c473c", cursor: "#5e9c72", cursorAccent: "#faf6ee",
      selectionBackground: "#ddd3c0",
      black: "#4c473c", red: "#c25f50", green: "#5e9c72", yellow: "#b8862f",
      blue: "#5f83a8", magenta: "#9c7a9c", cyan: "#58948d", white: "#efe9dc",
      brightBlack: "#857d6b", brightRed: "#d07f6f", brightGreen: "#79b58c", brightYellow: "#cfa35a",
      brightBlue: "#7fa0c2", brightMagenta: "#b294b2", brightCyan: "#77aca5", brightWhite: "#faf6ee"
    }
  })
  const fit = new FitAddon.FitAddon()
  term.loadAddon(fit)
  term.open(document.getElementById("terminal"))
  fit.fit()

  const consumer = createConsumer()
  const sub = consumer.subscriptions.create(
    { channel: "TerminalChannel", token: <%= token.to_json.html_safe %> },
    {
      connected() { this.perform("resize", { rows: term.rows, cols: term.cols }) },
      received(data) { term.write(Uint8Array.from(atob(data), c => c.charCodeAt(0))) },
      // The token lives 12 hours, but an installed PWA sits in the background
      // for days and then wakes up with an expired one — the tab looks alive
      // while the terminal AND the mic are both dead. Reloading mints a fresh
      // token, so do that once; if a second rejection follows straight away the
      // cause isn't staleness, so say so instead of looping.
      rejected() {
        const last = Number(sessionStorage.getItem("asm-retoken") || 0)
        if (Date.now() - last > 30000) {
          sessionStorage.setItem("asm-retoken", String(Date.now()))
          return location.reload()
        }
        term.write("\r\nCouldn't connect — reload the page to try again.\r\n")
      },
      disconnected() { term.write("\r\nConnection lost — reload the page to reconnect.\r\n") }
    }
  )

  // Copies happen inside tmux (drag-select, or apps like claude's "c to copy")
  // and arrive here as OSC 52 — xterm core ignores it, so bridge it to the
  // browser clipboard ourselves.
  term.parser.registerOscHandler(52, data => {
    try {
      const b64 = data.split(";")[1]
      if (!b64 || b64 === "?") return true // "?" is a clipboard read — unsupported
      const text = new TextDecoder().decode(Uint8Array.from(atob(b64), c => c.charCodeAt(0)))
      if (navigator.clipboard) {
        navigator.clipboard.writeText(text).catch(() => {})
      } else { // plain-http fallback: execCommand needs a real DOM selection
        const ta = document.createElement("textarea")
        ta.value = text
        document.body.append(ta)
        ta.select()
        document.execCommand("copy")
        ta.remove()
        term.focus()
      }
    } catch {} // bad base64 from a misbehaving app — never break the parser
    return true
  })

  // Claude rings the terminal bell when it finishes a turn and wants you. When
  // Web Push is set up the box sends the notification itself (works backgrounded,
  // and on phones) — so only fall back to a foreground-tab Notification here when
  // push isn't active, to avoid notifying twice.
  term.onBell(() => {
    if (window.__pushActive) return
    if (window.Notification?.permission === "granted" && document.hidden) {
      try { new Notification(document.title, { body: "Claude is done — your turn." }) } catch {}
    }
  })

  // Voice: stream the browser mic into the box's virtual microphone (MicChannel
  // → PulseAudio pipe-source), so claude's OWN voice mode records it and
  // transcribes with Anthropic's model. Two ways to talk: HOLD the 🎤 button
  // (works on phones, which have no SPACE key) — or TAP 🎤 to arm and then hold
  // SPACE (desktop). Audio is sent ONLY while held.
  //
  // We never type a slash command into claude. Voice mode is simply left enabled
  // in config/claude-settings.json, so the ONLY thing this has to reproduce is a
  // held space. Typing "/voice" here used to toggle voice mode OFF (the bare
  // form is a toggle, and the setting already had it on), which is why the
  // button never once managed to start a recording.
  const mic = document.getElementById("mic")
  if (mic && navigator.mediaDevices?.getUserMedia && (window.AudioContext || window.webkitAudioContext)) {
    mic.hidden = false
    let stream, ctx, node, gain, armed = false, sending = false
    // Phones have no SPACE key to hold, so the mic button doubles as push-to-talk:
    // holding it emulates the held-SPACE stream claude records from (a physical
    // hold autorepeats spaces into the PTY; we reproduce that with an interval).
    let spaceTimer = null
    const talkStart = () => {
      sending = true
      sub.perform("input", { data: " " })
      spaceTimer ??= setInterval(() => sub.perform("input", { data: " " }), 100)
    }
    const talkStop = () => {
      sending = false
      if (spaceTimer) { clearInterval(spaceTimer); spaceTimer = null }
    }
    // No Esc on release: in claude that is chat:cancel, so letting go of the
    // button would abort the turn that is running.
    const disarm = () => {
      talkStop()
      armed = false; mic.dataset.on = "false"
      try { node?.disconnect(); gain?.disconnect(); ctx?.close() } catch {}
      stream?.getTracks().forEach(t => t.stop())
      stream = ctx = node = gain = null
    }
    const arm = async () => {
      if (armed) return true
      try {
        // Create the context in the gesture; iOS ignores a requested 16 kHz and
        // runs at the hardware rate, so we take the native rate and downsample.
        ctx = new (window.AudioContext || window.webkitAudioContext)()
      } catch { return false }
      try {
        stream = await navigator.mediaDevices.getUserMedia({ audio: { channelCount: 1, echoCancellation: true, noiseSuppression: true } })
        if (ctx.state === "suspended") await ctx.resume()    // iOS starts suspended
        const ratio = ctx.sampleRate / 16000                 // e.g. 48000/16000 = 3 → box-average down
        const src = ctx.createMediaStreamSource(stream)
        node = ctx.createScriptProcessor(4096, 1, 1)         // deprecated but universal; no worklet asset
        node.onaudioprocess = e => {
          if (!sending) return                               // only while talking
          const f = e.inputBuffer.getChannelData(0)          // Float32 @ native rate, mono
          const outLen = Math.max(1, Math.floor(f.length / ratio))
          const pcm = new Int16Array(outLen)                 // → 16 kHz s16le for PulseAudio
          for (let i = 0; i < outLen; i++) {
            let sum = 0
            const a = Math.floor(i * ratio), b = Math.min(f.length, Math.floor((i + 1) * ratio))
            for (let j = a; j < b; j++) sum += f[j]
            const s = sum / Math.max(1, b - a)
            pcm[i] = Math.max(-32768, Math.min(32767, s < 0 ? s * 0x8000 : s * 0x7fff))
          }
          const bytes = new Uint8Array(pcm.buffer)
          let bin = ""
          for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i])
          micSub.perform("chunk", { data: btoa(bin) })
        }
        gain = ctx.createGain(); gain.gain.value = 0         // silent sink so onaudioprocess fires
        src.connect(node); node.connect(gain); gain.connect(ctx.destination)
        armed = true; mic.dataset.on = "true"
        term.focus()                                         // claude reads the held space
        return true
      } catch { disarm(); return false } // mic denied / no gesture
    }
    const micSub = consumer.subscriptions.create(
      { channel: "MicChannel", token: <%= token.to_json.html_safe %> },
      { rejected() { disarm(); mic.title = "Voice needs the box's audio set up first" } }
    )
    // Hold the button to talk, streaming while held; a quick tap toggles voice
    // mode so desktop users can then hold SPACE. arm() (getUserMedia + audio)
    // MUST start inside the pointerdown gesture — iOS blocks the mic otherwise —
    // so we begin arming immediately and only start streaming once it's ready
    // and the finger is still down. pointer events cover mouse, touch and pen.
    let pressed = false, pressAt = 0, armedBefore = false
    mic.addEventListener("pointerdown", e => {
      e.preventDefault()                                     // no focus-steal / ghost click
      pressed = true; pressAt = Date.now(); armedBefore = armed
      arm().then(ok => { if (ok && pressed) talkStart() })   // stream once armed, if still held
    })
    const release = () => {
      if (!pressed) return
      pressed = false
      const tap = Date.now() - pressAt < 250
      talkStop()
      if (tap && armedBefore) disarm()                       // tap while on → leave voice mode
      // tap while off just armed it (stays on for SPACE / the next hold); a hold stays armed
    }
    mic.addEventListener("pointerup", release)
    mic.addEventListener("pointercancel", release)
    // Desktop: gate the stream to Space-held. Capture phase so we still see it
    // with the terminal focused; we never preventDefault, so Space still reaches
    // claude (its own bytes drive the recording — no interval needed here).
    addEventListener("keydown", e => { if (armed && e.code === "Space") sending = true }, true)
    addEventListener("keyup", e => { if (armed && e.code === "Space") sending = false }, true)
    addEventListener("blur", () => { talkStop() })           // focus lost mid-hold → stop
  }

  term.onData(data => sub.perform("input", { data }))

  // Resize the PTY only when the grid actually changes, and coalesce bursts into
  // one animation frame. Mobile fires resize/visualViewport events in storms
  // (address bar, momentum scroll, keyboard); hammering tmux with winsize changes
  // makes it redraw over itself — the garbled, repeated lines.
  let lastRows = term.rows, lastCols = term.cols, queued = false
  const refit = () => {
    fit.fit()
    if (term.rows === lastRows && term.cols === lastCols) return
    lastRows = term.rows; lastCols = term.cols
    sub.perform("resize", { rows: term.rows, cols: term.cols })
  }
  const scheduleRefit = () => {
    if (queued) return
    queued = true
    requestAnimationFrame(() => { queued = false; refit() })
  }
  addEventListener("resize", scheduleRefit)

  // Mobile keyboard: it shrinks the visual viewport but not the h-dvh layout
  // viewport, so the input line hides behind the keyboard. Pin the page to the
  // visible height when that height changes — but NOT on plain scroll, and never
  // snap to the bottom, which would fight the user scrolling back through history.
  const vv = window.visualViewport
  if (vv) {
    let lastH = Math.round(vv.height)
    vv.addEventListener("resize", () => {
      const h = Math.round(vv.height)
      document.body.style.height = h + "px"
      if (h !== lastH) { lastH = h; scheduleRefit() }
    })
  }

  // Touch scrollback: the history lives in tmux, not xterm (tmux only repaints
  // the visible rows), so scrolling means doing what a mouse wheel does — with
  // tmux mouse mode on, xterm forwards wheel events to tmux, which scrolls. But
  // phones emit no wheel, so translate a one-finger drag into synthetic wheel
  // events on xterm's screen element; xterm encodes them for whatever mouse mode
  // is active and forwards to tmux. A tap (no drag) still falls through to focus.
  const el = document.getElementById("terminal")
  const screen = () => term.element?.querySelector(".xterm-screen") || term.element
  const rowPx = () => Math.max(10, el.clientHeight / (term.rows || 24))
  const NOTCH_ROWS = 1          // finger-rows per wheel notch — 1 tracks the finger closely; raise it
                                // if a swipe flings the history, lower it if scrolling drags behind.
  let startY = null, lastY = null, dragging = false, acc = 0
  el.addEventListener("touchstart", e => {
    if (e.touches.length === 1) { startY = lastY = e.touches[0].clientY; dragging = false; acc = 0 }
  }, { passive: true })
  el.addEventListener("touchmove", e => {
    if (lastY === null || e.touches.length !== 1) return
    const y = e.touches[0].clientY
    if (!dragging && Math.abs(y - startY) < 8) return   // let a tap through to xterm
    dragging = true
    e.preventDefault()                                  // touch-action:none already blocks native scroll
    acc += lastY - y                                    // finger down → negative → scroll up (history)
    lastY = y
    const step = rowPx() * NOTCH_ROWS
    while (Math.abs(acc) >= step) {                     // emit one notch per step of travel, direction only
      const up = acc < 0
      acc += up ? step : -step
      screen()?.dispatchEvent(new WheelEvent("wheel", { deltaY: up ? -1 : 1, deltaMode: 1, bubbles: true, cancelable: true }))
    }
  }, { passive: false })
  const endTouch = () => { startY = lastY = null; acc = 0 }
  el.addEventListener("touchend", endTouch, { passive: true })
  el.addEventListener("touchcancel", endTouch, { passive: true })

  // iOS/Android give no drag-select or double-tap paste over xterm's canvas, so
  // offer an explicit clipboard button on touch devices. term.paste respects the
  // app's bracketed-paste mode (claude needs it for multi-line input).
  const paste = document.getElementById("paste")
  if (paste && navigator.clipboard?.readText && matchMedia("(pointer: coarse)").matches) {
    paste.hidden = false
    paste.addEventListener("click", async () => {
      try {
        const text = await navigator.clipboard.readText()
        if (text) { term.paste(text); term.focus() }
      } catch {} // clipboard blocked — nothing to paste
    })
  }

  term.focus()
</script>

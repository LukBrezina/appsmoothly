<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Appsmoothly" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@1,9..144,500;1,9..144,600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-dvh flex flex-col bg-bg text-ink font-mono text-[13px] leading-relaxed antialiased">
    <header class="flex items-center gap-3 sm:gap-5 px-2.5 sm:px-6 py-2 sm:py-2.5 border-b border-line bg-linear-to-b from-panel to-transparent shrink-0">
      <a class="font-serif italic font-semibold text-[19px] sm:text-[21px] text-strong tracking-tight" href="<%= root_path %>">Appsmoothly</a>
      <span class="px-2.5 py-1 text-[11px] tracking-[0.12em] border border-strong/40 text-strong bg-panel-2 clip-tag whitespace-nowrap truncate max-w-[45vw]"><%= Factory.app_name %></span>
    </header>

    <% if flash[:alert] || flash[:notice] %>
      <p class="mx-4 sm:mx-6 mt-3 px-3.5 py-2.5 text-xs border clip-tag <%= flash[:alert] ? "border-danger text-danger bg-danger/5" : "border-live/40 text-live bg-live/5" %>">
        <%= flash[:alert] || flash[:notice] %>
      </p>
    <% end %>

    <main class="flex-1 flex flex-col min-h-0 min-w-0 overflow-auto">
      <%= yield %>
    </main>
  </body>
</html>

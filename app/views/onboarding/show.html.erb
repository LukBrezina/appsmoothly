<% content_for :title, "Get started — Appsmoothly" %>

<section class="flex-1 min-h-0 flex flex-col p-7 max-w-5xl w-full mx-auto">
  <div class="flex items-baseline gap-4 mb-2">
    <h2 class="text-[11px] font-medium tracking-[0.3em] text-dim uppercase">Get started</h2>
    <span class="flex-1 border-t border-line-soft"></span>
  </div>
  <p class="text-[11px] text-dim leading-relaxed mt-0 mb-6 max-w-2xl">
    Claude is the developer you'll talk to — in plain language, by typing or by
    speaking. Sign it in here, pick something to start from, and everything after
    that happens in the conversation.
  </p>

  <article class="card bg-panel border border-line clip-tag p-4 flex items-center gap-3.5 mb-3.5">
    <span id="perms-dot" class="dot" data-state="idle"></span>
    <div class="flex-1">
      <h3 class="m-0 text-[15px] font-medium text-strong leading-tight">Notifications, copy &amp; voice</h3>
      <p class="m-0 mt-1 text-xs text-dim italic">One tap lets this page copy from the terminal, ping you when Claude finishes, and use the microphone for voice.</p>
    </div>
    <button id="enable-perms" type="button"
            class="font-medium text-[11px] tracking-[0.14em] text-bg bg-live hover:brightness-110 px-3.5 py-2 clip-tag cursor-pointer whitespace-nowrap">ALLOW →</button>
  </article>
  <script>
    // Browsers only grant clipboard/notifications/mic inside a real click — do
    // all three here so copy-from-terminal and voice work everywhere after.
    document.getElementById("enable-perms")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget
      btn.textContent = "…"
      try { await Notification.requestPermission() } catch {}
      try { await navigator.clipboard.writeText("") } catch {}
      try { (await navigator.mediaDevices.getUserMedia({ audio: true })).getTracks().forEach(t => t.stop()) } catch {}
      btn.textContent = "✓ ALLOWED"
      btn.disabled = true
      document.getElementById("perms-dot").dataset.state = "live"
    })
  </script>

  <article class="card bg-panel border border-line clip-tag p-4 flex items-center gap-3.5 mb-6">
    <span class="dot" data-state="<%= Onboarding.ready? ? "live" : "idle" %>"></span>
    <div class="flex-1">
      <h3 class="m-0 text-[15px] font-medium text-strong leading-tight">Claude</h3>
      <p class="m-0 mt-1 text-xs text-dim italic">Signs in right here in the browser — nothing to install on your computer.</p>
    </div>
    <% if Onboarding.ready? %>
      <span class="text-[11px] tracking-[0.14em] text-live">✓ SIGNED IN</span>
    <% elsif !Onboarding.installed? %>
      <span class="text-[11px] text-idle">not installed yet — re-run the setup script on this machine</span>
    <% elsif @token %>
      <span class="text-[11px] text-idle italic">waiting below ↓</span>
    <% else %>
      <%= button_to "SIGN IN →", onboarding_login_path, form: { class: "contents" },
            class: "font-medium text-[11px] tracking-[0.14em] text-bg bg-live hover:brightness-110 px-3.5 py-2 clip-tag cursor-pointer" %>
    <% end %>
  </article>

  <% if Onboarding.ready? %>
    <div class="flex items-baseline gap-4 mb-3.5">
      <h2 class="text-[11px] font-medium tracking-[0.3em] text-dim uppercase">Start from</h2>
      <span class="flex-1 border-t border-line-soft"></span>
    </div>
    <div class="flex flex-col gap-3.5">
      <%= button_to onboarding_path, params: { starter: "starter" }, form: { class: "contents" },
            class: "card bg-panel border border-line clip-tag p-4 flex items-center gap-3.5 text-left w-full hover:border-line-hover cursor-pointer" do %>
        <span class="dot" data-state="live"></span>
        <span class="flex-1">
          <span class="block text-[15px] font-medium text-strong leading-tight">The Appsmoothly starter app</span>
          <span class="block mt-1 text-xs text-dim italic">A working app with sign-in, email and payments already wired up. Best place to start.</span>
        </span>
        <span class="text-[11px] tracking-[0.14em] text-live whitespace-nowrap">USE THIS →</span>
      <% end %>

      <%= form_with url: onboarding_path, method: :post, data: { turbo: false },
            class: "card bg-panel border border-line clip-tag p-4 flex items-center gap-3.5" do |f| %>
        <%= f.hidden_field :starter, value: "repo" %>
        <span class="dot" data-state="idle"></span>
        <span class="flex-1">
          <span class="block text-[15px] font-medium text-strong leading-tight">Something you already have</span>
          <%= f.text_field :repo, placeholder: "https://github.com/you/your-app", autocomplete: "off",
                class: "block mt-1.5 w-full max-w-md bg-panel-2 border border-line px-2.5 py-1.5 text-xs text-ink outline-none focus:border-line-hover" %>
        </span>
        <%= f.submit "BRING IT IN →", class: "text-[11px] tracking-[0.14em] text-idle border border-idle/50 px-3 py-2 clip-tag hover:bg-idle/10 cursor-pointer whitespace-nowrap" %>
      <% end %>

      <%= button_to "or just start talking to Claude →", onboarding_path, form: { class: "contents" },
            class: "text-[11px] text-faint hover:text-dim text-right bg-transparent border-0 cursor-pointer p-0 mt-1" %>
    </div>
  <% end %>

  <% if @token %>
    <div class="flex-1 min-h-[300px] flex flex-col border border-line bg-panel-2 clip-tag mt-6">
      <div class="flex items-center gap-2.5 px-4 py-2 border-b border-line-soft text-xs shrink-0">
        <span class="dot" data-state="live"></span>
        <strong class="font-medium text-strong">Follow the steps below — when your sign-in link is ready, a button appears here.</strong>
        <span class="ml-auto flex items-center gap-2.5">
          <a id="login-link" hidden target="_blank" rel="noopener" class="font-medium text-[10px] tracking-[0.14em] text-bg bg-live hover:brightness-110 px-2.5 py-1 clip-tag whitespace-nowrap">OPEN SIGN-IN PAGE ↗</a>
          <a href="<%= onboarding_path %>" class="text-[10px] tracking-[0.14em] text-live border border-live/40 px-2.5 py-1 clip-tag hover:bg-live/10 whitespace-nowrap">I'M DONE — CHECK ✓</a>
        </span>
      </div>
      <div id="terminal" class="flex-1 min-h-0 overflow-hidden"></div>
    </div>
    <%= render "shared/terminal", token: @token %>
    <script type="module">
      // The sign-in link only appears mid-flow, so poll for it.
      const link = document.getElementById("login-link")
      setInterval(async () => {
        const { url } = await fetch("<%= onboarding_link_path %>").then(r => r.json()).catch(() => ({}))
        if (url) link.href = url
        link.hidden = !url
      }, 2000)
    </script>
  <% end %>
</section>

#!/bin/bash
# secret <NAME>            print a stored secret
# secret --list            names only, never values
# secret --run <NAME> -- cmd...   run cmd with NAME exported, without printing it
set -euo pipefail
DIR="$HOME/.secrets"
case "${1:-}" in
  --list) ls -1 "$DIR" 2>/dev/null || echo "(none)"; exit 0 ;;
  --run)
      NAME="${2:?usage: secret --run <NAME> -- cmd...}"; shift 2
      [ "${1:-}" = "--" ] && shift
      [ -r "$DIR/$NAME" ] || { echo "no secret '$NAME' -- ask for it with: ask-secret $NAME" >&2; exit 1; }
      export "$NAME=$(cat "$DIR/$NAME")"
      exec "$@" ;;
  "" ) echo "usage: secret <NAME> | --list | --run <NAME> -- cmd..." >&2; exit 1 ;;
esac
NAME="$1"
[ -r "$DIR/$NAME" ] || { echo "no secret '$NAME' -- ask for it with: ask-secret $NAME" >&2; exit 1; }
cat "$DIR/$NAME"

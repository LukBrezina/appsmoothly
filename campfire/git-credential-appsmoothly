#!/bin/bash
# git credential helper: use the token the human pasted via `ask-secret`.
#
# `ask-secret GITHUB_TOKEN "to push the project repo"` drops the value in
# ~/.secrets/GITHUB_TOKEN without it ever touching the chat transcript. This is
# what makes git actually use it, so pasting the token is the whole setup step
# rather than the first half of one.
#
# Absent token = silent no-op, so git falls through to whatever else is
# configured and a VM with no token behaves exactly as before.
#
# Only ever answers for github.com, and only for https. It never writes: `store`
# and `erase` are deliberately unimplemented, so git cannot quietly persist a
# credential somewhere this script does not control.
set -euo pipefail

[ "${1:-}" = "get" ] || exit 0

declare -A q=()
while IFS='=' read -r k v; do
    [ -n "$k" ] || break
    q["$k"]="$v"
done

[ "${q[protocol]:-}" = "https" ] || exit 0
case "${q[host]:-}" in github.com) ;; *) exit 0 ;; esac

TOKEN_FILE="$HOME/.secrets/GITHUB_TOKEN"
[ -r "$TOKEN_FILE" ] || exit 0
TOKEN=$(tr -d '\r\n' < "$TOKEN_FILE")
[ -n "$TOKEN" ] || exit 0

echo "username=x-access-token"
echo "password=$TOKEN"

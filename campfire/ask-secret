#!/bin/bash
# ask-secret <NAME> [why you need it]
#
# Posts a one-time link into #workspace. The human opens it and pastes the
# value; it lands in ~/.secrets/<NAME> on this VM and never touches the chat
# transcript. Read it afterwards with:  secret <NAME>
set -euo pipefail
NAME="${1:-}"
[ -n "$NAME" ] || { echo "usage: ask-secret <NAME> [reason]" >&2; exit 1; }
[[ "$NAME" =~ ^[A-Za-z0-9_.-]+$ ]] || { echo "name must be alphanumeric/._-" >&2; exit 1; }
shift || true
REASON="$*"

TOKEN=$(openssl rand -hex 16)
STATE="$HOME/.local/state/claude-bot"
REQ="$STATE/secret-requests.json"
mkdir -p "$STATE"; chmod 700 "$STATE"
[ -f "$REQ" ] || echo '{}' > "$REQ"

URL="https://secret.$(hostname).appsmoothly.com/secret/$TOKEN"

# The bridge reads this file; room_path lets it confirm back into the same room.
# Ask Rails for the path rather than guessing it -- the bot route has no
# "/bot/" segment, and hand-built paths silently 404.
ROOM_PATH=$(sudo docker exec campfire bin/rails runner '
  bot = User.active_bots.find_by(name: "Claude")
  # By type, not name -- the room is user-renameable.
  room = bot&.rooms&.where(type: "Rooms::Direct")&.first || bot&.rooms&.order(:id)&.first
  puts (bot && room) ? Rails.application.routes.url_helpers.room_bot_messages_path(room, bot.bot_key) : ""
' 2>/dev/null | tr -d '\r' | tail -1)

python3 - "$REQ" "$TOKEN" "$NAME" "$REASON" "$ROOM_PATH" <<'PY'
import json, os, sys
req, token, name, reason, room_path = sys.argv[1:6]
try:
    with open(req) as f: data = json.load(f)
except Exception: data = {}
data[token] = {"name": name, "reason": reason, "room_path": room_path}
tmp = req + ".tmp"
with open(tmp, "w") as f: json.dump(data, f)
os.chmod(tmp, 0o600); os.replace(tmp, req)
PY

MSG="I need a value for <strong>$(printf '%s' "$NAME" | sed 's/&/\&amp;/g; s/</\&lt;/g')</strong>"
[ -n "$REASON" ] && MSG="$MSG — $(printf '%s' "$REASON" | sed 's/&/\&amp;/g; s/</\&lt;/g')"
MSG="$MSG.<br><br>Paste it here instead of in the chat: <a href=\"$URL\">$URL</a><br><em>One-time link. The value is stored on this VM and stays out of this conversation.</em>"

sudo docker exec -e MSG="$MSG" campfire bin/rails runner '
  user = User.where.not(role: :bot).order(:id).first
  bot  = User.active_bots.find_by(name: "Claude")
  Current.user = bot || user
  room = bot&.rooms&.where(type: "Rooms::Direct")&.first || bot&.rooms&.order(:id)&.first
  abort("no room") unless room
  room.messages.create!(creator: bot || user, body: ENV["MSG"])
' >/dev/null 2>&1 && echo "asked in the direct room: $URL" || { echo "could not post to chat; link is: $URL" >&2; }

#!/bin/bash
# room -- rooms Claude actually talks in.
#
#   room new "Search rewrite" [--cwd DIR] [--brief "..."] [--model M]
#                                           create an open room with its own
#                                           Claude session, everyone can read it
#   room say <name|id> "text"               post into another room from here
#   room list                               what exists, watched or tag-only,
#                                           and where each session runs
#   room watch <name|id> [--cwd DIR] [--model M]
#                                           make Claude answer everything here
#   room unwatch <name|id>                  back to tag-only
#   room close <name|id>                    delete the room and end its session
#
# A *watched* room is an ordinary open room -- visible to everyone in the
# project, so a colleague can follow along -- in which Claude replies to every
# message without being tagged. One room, one Claude session, one working
# directory. That is the unit: give a feature a room, close the room when the
# feature ships.
#
# A session only exists once something is said in its room, and its replies go
# to its own room and nowhere else. So creating a room does NOT move the
# conversation into it -- pass --brief to start the work there, or use
# `room say` to speak into a room you are not in.
#
# A feature room runs on a stronger model than chat does (opus by default here,
# sonnet for ordinary conversation): a room exists in order to get work done,
# and that is the phase worth paying for. Override per room with --model.
set -euo pipefail

# A room is created in order to get work done, so it defaults to the model
# worth using for that. Ordinary chat keeps the bridge's cheaper default.
FEATURE_MODEL="${ROOM_DEFAULT_MODEL:-opus}"

STATE="${HOME}/.local/state/claude-bot"
ROOMS_FILE="$STATE/rooms.json"
CONF="${HOME}/.config/claude-bot/config.env"

dexec() {
    if docker ps >/dev/null 2>&1; then docker exec "$@"
    else sudo -n docker exec "$@"; fi
}

# Run Ruby inside the Campfire container. Values reach the script as explicit
# `-e NAME=value` arguments, never interpolated into the Ruby -- a room title is
# arbitrary text and would otherwise be a quoting bug waiting to happen. The
# value has to be spelled out rather than inherited (`-e NAME`), because the
# sudo fallback resets the environment and the inherited form would be empty.
# Callers append `|| true` to the command substitution: `set -e` with
# `pipefail` would otherwise kill the script on a failed run, before the case
# that reports *why* it failed -- which is the whole point of capturing it.
rails_runner() {
    local script="$1"; shift
    dexec "$@" campfire bin/rails runner "$script" 2>&1 | tr -d '\r'
}

usage() { sed -n '2,/^set -euo/p' "$0" | grep '^#' | sed 's/^# \{0,1\}//'; exit "${1:-1}"; }

# --- the room -> session mapping the bridge reads --------------------------
map_set() {  # <room_id> <key> <value>   (empty value clears the key)
    mkdir -p "$STATE"
    python3 - "$ROOMS_FILE" "$1" "$2" "$3" <<'MAPPY'
import json, os, sys
path, room_id, key, value = sys.argv[1:5]
try:
    with open(path) as f: data = json.load(f)
except Exception: data = {}
entry = data.get(room_id, {})
if value: entry[key] = value
else: entry.pop(key, None)
if entry: data[room_id] = entry
else: data.pop(room_id, None)
tmp = path + ".tmp"
with open(tmp, "w") as f: json.dump(data, f, indent=2)
os.replace(tmp, path)
MAPPY
}

map_get() {  # <room_id> <key> -> value or ""
    python3 - "$ROOMS_FILE" "$1" "$2" <<'MAPPY' 2>/dev/null || true
import json, sys
path, room_id, key = sys.argv[1:4]
try:
    with open(path) as f:
        print((json.load(f).get(room_id) or {}).get(key, ""))
except Exception:
    pass
MAPPY
}

map_del() {  # drop a room's whole entry
    mkdir -p "$STATE"
    python3 - "$ROOMS_FILE" "$1" <<'MAPPY' 2>/dev/null || true
import json, os, sys
path, room_id = sys.argv[1:3]
try:
    with open(path) as f: data = json.load(f)
except Exception: data = {}
data.pop(room_id, None)
tmp = path + ".tmp"
with open(tmp, "w") as f: json.dump(data, f, indent=2)
os.replace(tmp, path)
MAPPY
}

# Ask the bridge to end a room's Claude session. Best-effort: if the bridge is
# down there is no session to end anyway.
bridge_close() {
    [ -r "$CONF" ] || return 0
    local secret addr port
    secret=$(sed -n 's/^BRIDGE_SECRET=//p' "$CONF")
    addr=$(sed -n 's/^LISTEN_ADDR=//p' "$CONF"); addr="${addr:-172.17.0.1}"
    port=$(sed -n 's/^LISTEN_PORT=//p' "$CONF"); port="${port:-4488}"
    [ -n "$secret" ] || return 0
    curl -sS -X POST --max-time 10 "http://$addr:$port/close/$secret/$1" >/dev/null 2>&1 || true
}

project_url() { echo "https://$(hostname).appsmoothly.com"; }

# Campfire messages are rich text, so a title with an ampersand in it would
# otherwise arrive as markup.
esc() { printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }

# Claude Code ignores a directory's settings.local.json until that directory has
# been trusted, and a feature worktree is always new. There is no way to answer
# an interactive trust dialog from chat, and the VM is the security boundary --
# not a path inside it -- so record trust for the directory we were just asked
# to work in.
trust_dir() {
    python3 - "$HOME/.claude.json" "$1" <<'TRUSTPY' 2>/dev/null || true
import json, os, sys
path, d = sys.argv[1:3]
try:
    with open(path) as f: data = json.load(f)
except Exception: data = {}
entry = data.setdefault("projects", {}).setdefault(d, {})
if entry.get("hasTrustDialogAccepted") is not True:
    entry["hasTrustDialogAccepted"] = True
    tmp = path + ".tmp"
    with open(tmp, "w") as f: json.dump(data, f, indent=2)
    os.replace(tmp, path)
TRUSTPY
}

# --- ruby fragments ---------------------------------------------------------
FIND_ROOM='
  key = ENV["ROOM_KEY"]
  room = key =~ /\A\d+\z/ ? Room.find_by(id: key) : nil
  room ||= Room.where(name: key).order(:id).first
  room ||= Room.where("LOWER(name) = ?", key.downcase).order(:id).first
  abort "no room matching #{key.inspect}" unless room
'

case "${1:-}" in

new)
    shift
    TITLE=""; CWD=""; BRIEF=""; MODEL="$FEATURE_MODEL"
    while [ $# -gt 0 ]; do
        case "$1" in
            --cwd) CWD="${2:-}"; shift 2 ;;
            --brief) BRIEF="${2:-}"; shift 2 ;;
            --model) MODEL="${2:-}"; shift 2 ;;
            -h|--help) usage 0 ;;
            *) [ -z "$TITLE" ] && TITLE="$1"; shift ;;
        esac
    done
    [ -n "$TITLE" ] || usage
    [ -z "$CWD" ] || CWD=$(cd "$CWD" && pwd)   # fail loudly if it does not exist
    [ -z "$CWD" ] || trust_dir "$CWD"

    OUT=$(rails_runner '
      title = ENV["ROOM_TITLE"]
      user = User.where.not(role: :bot).order(:id).first
      abort "no human user yet -- finish Campfire first-run" unless user
      Current.user = user
      bots = User.active_bots.to_a
      abort "no bot yet" if bots.empty?

      room = Room.where(name: title).where.not(type: "Rooms::Direct").order(:id).first
      room ||= Rooms::Open.create_for({ name: title }, users: (User.active.to_a | bots))

      # Everyone in the project sees it. That is the point of not using a DM:
      # a colleague can read what was built and why.
      missing = User.active.where.not(id: room.memberships.select(:user_id)).to_a
      room.memberships.grant_to(missing) if missing.any?

      # `everything` is what makes Claude answer without being tagged.
      room.memberships.where(user_id: bots.map(&:id)).update_all(involvement: "everything")
      puts "OK\t#{room.id}"
    ' -e ROOM_TITLE="$TITLE") || true
    case "$OUT" in
        OK*) ID=$(printf '%s' "$OUT" | awk -F'\t' '/^OK/{print $2}') ;;
        *) echo "${OUT:-room: the command produced no output}" >&2; exit 1 ;;
    esac
    [ -n "$CWD" ] && map_set "$ID" cwd "$CWD"
    [ -n "$MODEL" ] && map_set "$ID" model "$MODEL"
    bridge_close "$ID"     # start clean if the id was ever used before

    # A brand-new room is silent, and a silent room has no session -- so it
    # looks broken from the outside: the room exists and nothing ever happens
    # in it. Say what it is for, as the bot, so anyone opening it can see it is
    # live and where it is working.
    OPENER="This room is <strong>$(esc "$TITLE")</strong>."
    [ -n "$CWD" ] && OPENER="$OPENER Working in <code>$(esc "$CWD")</code>."
    OPENER="$OPENER I answer every message here, no need to tag me."
    [ -n "$MODEL" ] && OPENER="$OPENER Running on <code>$(esc "$MODEL")</code>."
    ROOM_OPENER="$OPENER" rails_runner '
      bot  = User.active_bots.order(:id).first
      room = Room.find(ENV["ROOM_ID"].to_i)
      room.messages.create!(creator: bot, body: ENV["ROOM_OPENER"]) if bot
    ' -e ROOM_ID="$ID" -e ROOM_OPENER="$OPENER" >/dev/null || true

    # With a brief, hand the work over for real: post it as the human who asked
    # and deliver it, which is what starts the session -- in this room, in its
    # own directory. Without one the room simply waits for someone to type.
    if [ -n "$BRIEF" ]; then
        rails_runner '
          user = User.where.not(role: :bot).order(:id).first
          Current.user = user
          room = Room.find(ENV["ROOM_ID"].to_i)
          msg  = room.messages.create!(creator: user, body: ENV["ROOM_BRIEF"])
          room.users.active_bots.excluding(msg.creator).each { |b| b.deliver_webhook_later(msg) }
        ' -e ROOM_ID="$ID" -e ROOM_BRIEF="$BRIEF" >/dev/null || true
    fi

    echo "room  : $TITLE"
    echo "url   : $(project_url)/rooms/$ID"
    echo "claude: answers every message here${CWD:+, running in $CWD}"
    echo "model : ${MODEL:-(bridge default)}"
    if [ -n "$BRIEF" ]; then
        echo "brief : posted -- the session for this room has started there"
    else
        echo "note  : nobody has spoken in it yet, so no session is running there."
        echo "        Pass --brief \"...\" to start the work, or say something in the room."
    fi
    ;;

say)
    shift
    KEY="${1:-}"; shift || true
    TEXT="$*"
    [ -n "$KEY" ] && [ -n "$TEXT" ] || usage
    # Your replies go to your own room and nowhere else. This is how you speak
    # into another one -- a handover, or reporting back when work is done.
    OUT=$(rails_runner "$FIND_ROOM"'
      bot = User.active_bots.order(:id).first
      abort "no bot" unless bot
      room.messages.create!(creator: bot, body: ENV["ROOM_TEXT"])
      puts "OK\t#{room.id}\t#{room.name}"
    ' -e ROOM_KEY="$KEY" -e ROOM_TEXT="$TEXT") || true
    case "$OUT" in
        OK*) echo "posted to $(printf '%s' "$OUT" | awk -F'\t' '/^OK/{print $3}')" ;;
        *) echo "${OUT:-room: the command produced no output}" >&2; exit 1 ;;
    esac
    ;;

list)
    rails_runner '
      bot_ids = User.active_bots.ids
      Room.order(:id).each do |r|
        watched = r.direct? ||
          r.memberships.where(user_id: bot_ids, involvement: "everything").exists?
        name = r.name.presence || (r.direct? ? "(direct)" : "(unnamed)")
        puts [ r.id, r.type.sub("Rooms::", "").downcase,
               (watched ? "watched" : "tag-only"), name ].join("\t")
      end
    ' | while IFS=$'\t' read -r id kind mode name; do
        [ -n "${id:-}" ] || continue
        cwd=$(map_get "$id" cwd); model=$(map_get "$id" model)
        printf '%-5s %-7s %-9s %-30s %-8s %s\n' \
               "$id" "$kind" "$mode" "$name" "${model:-}" "${cwd:-}"
    done
    ;;

watch|unwatch)
    ACTION="$1"; shift
    KEY="${1:-}"; shift || true
    CWD=""; MODEL=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --cwd)   CWD=$(cd "${2:-}" && pwd); shift 2 ;;
            --model) MODEL="${2:-}"; shift 2 ;;
            *) shift ;;
        esac
    done
    [ -n "$KEY" ] || usage
    INV=$([ "$ACTION" = watch ] && echo everything || echo mentions)
    OUT=$(rails_runner "$FIND_ROOM"'
      if room.direct?
        abort "#{room.id} is a direct room -- it always reaches the bot"
      end
      bots = User.active_bots.to_a
      absent = bots.reject { |b| room.memberships.exists?(user_id: b.id) }
      room.memberships.grant_to(absent) if absent.any?
      room.memberships.where(user_id: bots.map(&:id)).update_all(involvement: ENV["ROOM_INV"])
      puts "OK\t#{room.id}\t#{room.name}"
    ' -e ROOM_KEY="$KEY" -e ROOM_INV="$INV") || true
    case "$OUT" in
        OK*) ID=$(printf '%s' "$OUT" | awk -F'\t' '/^OK/{print $2}')
             NAME=$(printf '%s' "$OUT" | awk -F'\t' '/^OK/{print $3}') ;;
        *) echo "${OUT:-room: the command produced no output}" >&2; exit 1 ;;
    esac
    [ -n "$CWD" ] && { map_set "$ID" cwd "$CWD"; trust_dir "$CWD"; }
    [ -n "$MODEL" ] && map_set "$ID" model "$MODEL"
    # The running session was started with the old directory and model, so end
    # it; the next message picks the new ones up.
    { [ -n "$CWD" ] || [ -n "$MODEL" ]; } && bridge_close "$ID"
    if [ "$ACTION" = watch ]; then
        echo "$NAME ($ID): Claude answers every message${CWD:+, running in $CWD}${MODEL:+ on $MODEL}"
    else
        echo "$NAME ($ID): Claude only answers when tagged"
    fi
    ;;

close)
    shift
    KEY="${1:-}"; [ -n "$KEY" ] || usage
    OUT=$(rails_runner "$FIND_ROOM"'
      if room.direct?
        abort "refusing to delete a direct room"
      end
      if [ "System", "All Talk", "AppSmoothly" ].include?(room.name)
        abort "#{room.name.inspect} is a standing room, not a feature room"
      end
      id, name = room.id, room.name
      room.destroy!
      puts "OK\t#{id}\t#{name}"
    ' -e ROOM_KEY="$KEY") || true
    case "$OUT" in
        OK*) ID=$(printf '%s' "$OUT" | awk -F'\t' '/^OK/{print $2}')
             NAME=$(printf '%s' "$OUT" | awk -F'\t' '/^OK/{print $3}') ;;
        *) echo "${OUT:-room: the command produced no output}" >&2; exit 1 ;;
    esac
    bridge_close "$ID"
    map_del "$ID"
    echo "closed $NAME ($ID); its Claude session is gone"
    echo "note: anything else the room used -- a worktree, a route file, a"
    echo "      service -- is yours to clean up. See deploy-previews."
    ;;

-h|--help|help|"") usage 0 ;;
*) echo "room: unknown command '${1}'" >&2; usage ;;
esac

#!/bin/bash
# Clone the workspace repo to /home/appsmoothly (the repo IS the working
# directory) and the Campfire source under projects/. Idempotent.
set -euo pipefail
STATE=/var/lib/campfire-init
REPO=/home/appsmoothly

install -d -o lukas -g lukas "$REPO"

clone_or_update() {  # <url> <dest>
    local url="$1" dest="$2"
    if [ -d "$dest/.git" ]; then
        sudo -u lukas git -C "$dest" pull --ff-only --quiet 2>&1 | tail -1 || true
    else
        sudo -u lukas git clone -q "$url" "$dest" 2>&1 | tail -1 || {
            echo "  WARN: could not clone $url" >&2; return 0; }
    fi
}

# The repo has to be cloned into a directory that may already exist.
if [ ! -d "$REPO/.git" ]; then
    tmp=$(mktemp -d); chown lukas:lukas "$tmp"
    if sudo -u lukas git clone -q https://github.com/LukBrezina/appsmoothly.git "$tmp/r"; then
        shopt -s dotglob; mv "$tmp/r"/* "$REPO"/ 2>/dev/null || true; shopt -u dotglob
    fi
    rm -rf "$tmp"
else
    sudo -u lukas git -C "$REPO" pull --ff-only --quiet || true
fi

clone_or_update https://github.com/basecamp/once-campfire.git "$REPO/projects/once-campfire"

chown -R lukas:lukas "$REPO"
touch "$STATE/bootstrapped"
echo "bootstrapped $REPO"

#!/bin/bash
# appsmoothly-install -- put the runtime that lives in the workspace repo into
# service.
#
# /home/appsmoothly is a git checkout that fast-forwards hourly, and its
# campfire/ directory is the source of truth for the bridge, the helper CLIs,
# the systemd units, the Caddy route files and the Campfire initializers. A
# checkout is not an install: this is the step that makes a pushed change take
# effect -- on VMs that already exist, not just on the next one built.
#
# Idempotent and quiet: it compares before it copies, and only restarts what
# actually changed. Safe to run on every update tick.
#
# Note this means a push to the workspace repo runs as root in the VM. That is
# no wider than what is already true -- `lukas` has passwordless sudo in here
# and the agent runs as `lukas` -- and the VM is the security boundary, not the
# user account inside it.
set -euo pipefail

REPO=/home/appsmoothly
SRC="$REPO/campfire"
CAMPFIRE_SRC="$REPO/projects/once-campfire"
[ -d "$SRC" ] || { echo "appsmoothly-install: no $SRC yet"; exit 0; }

bridge_changed=0; units_changed=0; caddy_changed=0; rails_changed=0; any_changed=0

put() {  # <mode> <src> <dst>   -> 0 if it changed
    local mode="$1" src="$2" dst="$3"
    [ -f "$src" ] || return 1
    if cmp -s "$src" "$dst" 2>/dev/null; then return 1; fi
    install -D -m "$mode" -o root -g root "$src" "$dst"
    echo "  $dst"
    any_changed=1
    return 0
}

echo "==> runtime"
install -d -m 755 /opt/claude-bot
put 755 "$SRC/bridge.py"    /opt/claude-bot/bridge.py    && bridge_changed=1
put 755 "$SRC/vapid-gen.py" /opt/claude-bot/vapid-gen.py || true
put 644 "$SRC/avatar.png"   /opt/claude-bot/avatar.png   || true

echo "==> commands"
for f in notify ask-secret secret room git-credential-appsmoothly; do
    put 755 "$SRC/$f" "/usr/local/bin/$f" || true
done
# Wire the helper in for the agent's user. Harmless when no token is stored --
# the helper exits silently -- so this is safe on every VM, not just ones with
# a repo to push to.
if [ -x /usr/local/bin/git-credential-appsmoothly ]; then
    sudo -u lukas git config --global credential.https://github.com.helper appsmoothly 2>/dev/null || true
fi
# Not on PATH: `history` is a shell builtin, so a command by that name would
# never be reached anyway.
put 755 "$SRC/history" /opt/claude-bot/history || true
for f in appsmoothly-update appsmoothly-install campfire-init campfire-bot-init \
         campfire-update vm-bootstrap; do
    put 755 "$SRC/$f" "/usr/local/sbin/$f" || true
done

echo "==> factory"
# The factory (template + disposable run containers -- see the factory skill)
# ships with every VM but stays inert until cell-init is run: the commands are
# harmless without incus, and the refresh timer's unit refuses to fire without
# the /var/lib/factory/repo-url marker that only template-build creates.
FSRC="$REPO/factory"
if [ -d "$FSRC" ]; then
    put 755 "$FSRC/run" /usr/local/bin/run || true
    for f in cell-init template-build; do
        put 755 "$FSRC/$f" "/usr/local/sbin/$f" || true
    done
    for f in "$FSRC"/*.service "$FSRC"/*.timer; do
        [ -e "$f" ] || continue
        put 644 "$f" "/etc/systemd/system/$(basename "$f")" && units_changed=1
    done
    if [ -f /etc/systemd/system/template-refresh.timer ] &&
       ! systemctl is-enabled template-refresh.timer >/dev/null 2>&1; then
        systemctl daemon-reload
        systemctl enable --now template-refresh.timer >/dev/null 2>&1 || true
        echo "  template-refresh.timer enabled (inert until this VM becomes a cell)"
    fi
fi

echo "==> units"
for f in "$SRC"/*.service "$SRC"/*.timer; do
    [ -e "$f" ] || continue
    put 644 "$f" "/etc/systemd/system/$(basename "$f")" && units_changed=1
done

echo "==> routing"
# Static pages the agent publishes for the human to read -- see the
# publishing-notes skill. Owned by the agent's user so it can just write files.
install -d -m 755 -o lukas -g lukas /srv/notes
install -d -m 755 /etc/caddy/routes
put 644 "$SRC/Caddyfile" /etc/caddy/Caddyfile && caddy_changed=1
for f in "$SRC"/routes/*.caddy; do
    [ -e "$f" ] || continue
    put 644 "$f" "/etc/caddy/routes/$(basename "$f")" && caddy_changed=1
done

echo "==> campfire initializers"
# Additive patches to Campfire, kept as new files so the upstream checkout can
# still fast-forward. They only take effect once the image is rebuilt.
if [ -d "$CAMPFIRE_SRC/config/initializers" ]; then
    for f in "$SRC"/initializers/*.rb; do
        [ -e "$f" ] || continue
        put 644 "$f" "$CAMPFIRE_SRC/config/initializers/$(basename "$f")" && rails_changed=1
    done
fi

echo "==> applying"
if [ "$units_changed" = 1 ]; then
    systemctl daemon-reload
    echo "  systemd reloaded"
fi
PENDING=/var/lib/appsmoothly/restart-pending
if [ "$bridge_changed" = 1 ] || [ "$units_changed" = 1 ]; then
    install -d -m 755 /var/lib/appsmoothly; touch "$PENDING"
fi
if [ -f "$PENDING" ] && systemctl is-enabled claude-bot >/dev/null 2>&1; then
    # Restarting the bridge kills every running session, and a session can be
    # ten minutes into a test suite. Losing that costs more than the update is
    # worth, so wait for a quiet moment -- this runs hourly, and the marker
    # survives until it gets one. The already-installed bridge.py is inert
    # until the process restarts, so deferring is safe.
    if pgrep -f "claude.*--input-format stream-json" >/dev/null 2>&1; then
        echo "  claude-bot update DEFERRED: $(pgrep -cf "claude.*--input-format stream-json") session(s) running"
        echo "  it will restart on the next idle run, or: sudo systemctl restart claude-bot"
    else
        systemctl restart claude-bot; rm -f "$PENDING"; echo "  claude-bot restarted"
    fi
fi
if [ "$caddy_changed" = 1 ]; then
    if caddy validate --config /etc/caddy/Caddyfile >/dev/null 2>&1; then
        systemctl reload caddy 2>/dev/null || systemctl restart caddy
        echo "  caddy reloaded"
    else
        echo "  WARNING: Caddy config does not validate; NOT reloading" >&2
        caddy validate --config /etc/caddy/Caddyfile 2>&1 | tail -5 >&2
    fi
fi
if [ "$rails_changed" = 1 ]; then
    # A rebuild is minutes, so it only happens when an initializer really moved.
    echo "  campfire initializers changed -- rebuilding the image"
    if ! LOG=$(/usr/local/sbin/campfire-update --force 2>&1); then
        echo "$LOG" | tail -20 >&2
        # The old image keeps running, so nothing is broken -- but the change is
        # not live and this runs on a timer, where stderr goes nowhere anyone
        # looks. Say so in chat, the same way a failed repo update does.
        printf '%s\n' \
          "**Campfire did not rebuild.** The initializers in \`campfire/initializers/\`" \
          "changed, so the running image is behind the repo. It is still serving the" \
          "previous build, so chat works -- but whatever the new initializer does is" \
          "not in effect." "" "Last 20 lines:" '```' "$(echo "$LOG" | tail -20)" '```' "" \
          "Claude -- work out why and fix it. \`sudo /usr/local/sbin/campfire-update --force\`" \
          "rebuilds; the source is \`projects/once-campfire\`." \
        | /usr/local/bin/notify --ask || echo "  (could not reach chat either)" >&2
    fi
fi

[ "$any_changed" = 0 ] && echo "  nothing to do"
exit 0

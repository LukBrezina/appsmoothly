#!/bin/bash
# Creates the Claude bot once a human has completed Campfire's first-run.
# Runs on a timer until there is an account to attach the bot to, then wires up
# the bridge and disables itself.
set -euo pipefail
STATE=/var/lib/campfire-init
[ -f "$STATE/bot-done" ] && exit 0
curl -sf -o /dev/null http://127.0.0.1:8080/up 2>/dev/null || exit 0

if ! docker exec campfire bin/rails runner 'exit(Account.any? ? 0 : 1)' 2>/dev/null; then
    exit 0   # nobody has set Campfire up yet; try again next tick
fi

BRIDGE_SECRET=$(cat "$STATE/bridge-secret")
GW=$(ip -4 addr show docker0 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1)
GW="${GW:-172.17.0.1}"

BOT_KEY=$(docker exec campfire bin/rails runner "
  # The bot's name is the label Campfire shows for the direct room -- room.name
  # is ignored for direct rooms -- so this is effectively the chat's title.
  bot = User.active_bots.order(:id).first ||
        User.create_bot!(name: 'AppSmoothly', email_address: 'claude@bot.local',
                         password: SecureRandom.hex(16),
                         webhook_url: 'http://$GW:4488/hook/$BRIDGE_SECRET')
  puts bot.bot_key
" 2>/dev/null | tr -d '\r' | tail -1)

case "$BOT_KEY" in
  *-*) : ;;
  *) echo "bot not created yet (got '$BOT_KEY')" >&2; exit 0 ;;
esac

install -d -m 700 -o lukas -g lukas /home/lukas/.config/claude-bot /home/lukas/.local/state/claude-bot
cat > /home/lukas/.config/claude-bot/config.env <<EOF
BRIDGE_SECRET=$BRIDGE_SECRET
LISTEN_ADDR=$GW
LISTEN_PORT=4488
CAMPFIRE_BASE=http://127.0.0.1:8080
CLAUDE_BIN=/usr/local/bin/claude
WORKDIR=/home/appsmoothly
SESSIONS_FILE=/home/lukas/.local/state/claude-bot/sessions.json
CAMPFIRE_BOT_KEY=$BOT_KEY
EOF
chown lukas:lukas /home/lukas/.config/claude-bot/config.env
chmod 600 /home/lukas/.config/claude-bot/config.env

# Give the bot its avatar. ActiveStorage will not make a variant from an SVG
# (not a "variable" content type) and this build of vips has no SVG loader, so
# this is a PNG.
if [ -f /opt/claude-bot/avatar.png ]; then
    docker cp /opt/claude-bot/avatar.png campfire:/tmp/avatar.png 2>/dev/null &&
    docker exec campfire bin/rails runner '
      # The bot carries the identity of the direct room; the account carries the
      # identity of the whole Campfire install (title, favicon, login page).
      bot = User.active_bots.order(:id).first
      if bot && !bot.avatar.attached?
        bot.avatar.attach(io: File.open("/tmp/avatar.png"),
                          filename: "appsmoothly.png", content_type: "image/png")
      end
      acct = Account.first
      if acct
        acct.update!(name: "AppSmoothly") if acct.name.blank? || acct.name == "Campfire"
        unless acct.logo.attached?
          acct.logo.attach(io: File.open("/tmp/avatar.png"),
                           filename: "appsmoothly.png", content_type: "image/png")
        end
      end
    ' >/dev/null 2>&1 && echo "  avatar + account branding set"
fi

systemctl enable --now claude-bot

# Rooms.
#
# The main room is **All Talk** -- Campfire's own default room, which every
# install already has, and the room you land in. It is an ordinary open room, so
# everyone in the project can read it: the conversation that produced a feature
# is worth a colleague being able to scroll back through. Claude answers every
# message there without being tagged because its membership is
# `involvement: everything` -- see campfire/initializers/appsmoothly_agent_rooms.rb.
#
# No direct room is created. A DM to the bot still works if you start one, but
# it is not where the conversation is meant to live.
#
# #System stays tag-only, so automated notices land there without waking Claude.
docker exec campfire bin/rails runner '
  user = User.where.not(role: :bot).order(:id).first
  bot  = User.active_bots.order(:id).first
  if user && bot
    Current.user = user

    main = Room.where(name: "All Talk").where.not(type: "Rooms::Direct").order(:id).first
    main ||= Rooms::Open.create_for({ name: "All Talk" }, users: (User.active.to_a | [ bot ]))
    main.memberships.grant_to([ bot ]) unless main.memberships.exists?(user_id: bot.id)
    main.memberships.where(user_id: bot.id).update_all(involvement: "everything")

    Room.find_by(name: "System") ||
      Rooms::Open.create_for({ name: "System" }, users: [ user, bot ])
  end
' >/dev/null 2>&1 && echo "  rooms: All Talk (open, watched) + System"

touch "$STATE/bot-done"
systemctl disable --now campfire-bot-init.timer 2>/dev/null || true
echo "Claude bot created and bridge started"

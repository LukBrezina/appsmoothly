# In-VM router. Everything from outside arrives here on :80; this decides where
# it goes by hostname, so adding a service or a preview needs no change outside
# the VM.
#
# Hostname-agnostic on purpose: the VM does not know its own project name, and
# matching on the leading label means this file is identical in every VM.
#
# Everything reaching :80 already had TLS terminated upstream (outside this
# VM), so it's always really https — tell upstream apps that explicitly, or
# they compute http:// URLs and reject same-origin checks (CSRF, etc).
:80 {
	# app.<project>...  -> the project's application
	@app header_regexp Host ^app\.
	handle @app {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Forwarded-Proto https
		}
	}

	# Anything you add yourself. Drop a file in /etc/caddy/routes/ with its own
	# matcher + handle block; see the deploy-previews skill.
	import /etc/caddy/routes/*.caddy

	# Everything else -> Campfire, including the project's main hostname.
	handle {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Forwarded-Proto https
		}
	}

	# A 502 means the upstream is not listening -- for a run's preview host
	# that means the run is ASLEEP. The bridge answers with a page that wakes
	# it, so opening a preview URL is all it takes.
	handle_errors {
		# 502 = refused (stopped run), 504 = hung past the header timeout
		# (frozen run -- its kernel still accepts TCP). Both mean "wake it".
		@dead expression {err.status_code} == 502 || {err.status_code} == 504
		handle @dead {
			reverse_proxy 172.17.0.1:4488
		}
	}
}

#!/bin/bash
# Pull the latest Campfire from upstream, rebuild the image, restart the service.
# The Docker volume holds the database and uploads, so this keeps your messages.
set -euo pipefail
# Every git invocation runs as lukas: the checkout is lukas-owned and git
# refuses to operate on a repo owned by another uid ("dubious ownership").
SRC=/home/appsmoothly/projects/once-campfire
[ -d "$SRC/.git" ] || { echo "no checkout at $SRC" >&2; exit 1; }

echo "==> fetching upstream"
sudo -u lukas git -C "$SRC" fetch --quiet origin
BEFORE=$(sudo -u lukas git -C "$SRC" rev-parse HEAD)
sudo -u lukas git -C "$SRC" merge --ff-only origin/main
AFTER=$(sudo -u lukas git -C "$SRC" rev-parse HEAD)

if [ "$BEFORE" = "$AFTER" ]; then
    echo "==> already up to date ($(sudo -u lukas git -C "$SRC" log -1 --format=%h))"
    [ "${1:-}" = "--force" ] || exit 0
fi

# Our own additions live outside the upstream tree as new files, so the
# fast-forward above can never conflict with them -- but they do have to be back
# in place before the image is built.
INIT=/home/appsmoothly/campfire/initializers
if [ -d "$INIT" ]; then
    install -d -m 755 "$SRC/config/initializers"
    for f in "$INIT"/*.rb; do
        [ -e "$f" ] || continue
        install -m 644 -o lukas -g lukas "$f" "$SRC/config/initializers/$(basename "$f")"
    done
    echo "==> initializers: $(ls "$INIT" | tr '\n' ' ')"
fi

# Upstream's Procfile runs the resque workers with INTERVAL=0.1 -- polling
# every 100ms, which burned ~30% CPU per worker doing nothing, in every VM,
# forever. 2s is imperceptible for chat jobs. The edit exists only for the
# build and is reverted right after, so the checkout stays clean and the next
# fast-forward can never conflict.
sudo -u lukas sed -i 's/INTERVAL=0\.1/INTERVAL=2/' "$SRC/Procfile"

echo "==> building image"
# BuildKit is required: the Dockerfile uses COPY --chmod, which the legacy
# builder rejects. Needs the docker-buildx package.
DOCKER_BUILDKIT=1 docker build -q -t campfire:local "$SRC"
sudo -u lukas git -C "$SRC" checkout -- Procfile 2>/dev/null || true
echo "==> restarting"
systemctl restart campfire
for i in $(seq 1 40); do
    curl -sf -o /dev/null http://127.0.0.1:8080/up 2>/dev/null && { echo "==> healthy"; exit 0; }
    sleep 3
done
echo "==> did NOT come back healthy; check: journalctl -u campfire -n 50" >&2
exit 1

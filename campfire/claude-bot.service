[Unit]
Description=Campfire Claude bot bridge
After=campfire.service network-online.target
Wants=campfire.service

[Service]
User=lukas
Group=lukas
EnvironmentFile=/home/lukas/.config/claude-bot/config.env
ExecStart=/usr/bin/python3 /opt/claude-bot/bridge.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

#!/bin/bash
# Keep /home/appsmoothly current with origin/main.
#
# Clean tree + fast-forward is the normal path and should be all that ever
# happens: this repo only changes when something is pushed to it, and projects/
# is gitignored so ordinary work cannot dirty the tree.
#
# When it CANNOT fast-forward, we do not silently stop. We post into Campfire
# and let the Claude bot deal with it -- the path you already authorised, and
# one you can watch and interrupt.
set -uo pipefail
REPO=/home/appsmoothly
STATE=/var/lib/appsmoothly-update
mkdir -p "$STATE"
[ -d "$REPO/.git" ] || { echo "no checkout at $REPO"; exit 0; }

as_lukas() { sudo -u lukas git -C "$REPO" "$@"; }

as_lukas fetch --quiet origin 2>/dev/null || { echo "fetch failed"; exit 0; }

BEFORE=$(as_lukas rev-parse HEAD)
REMOTE=$(as_lukas rev-parse origin/main)
DIRTY=$(as_lukas status --porcelain)

# Already current and clean.
[ "$BEFORE" = "$REMOTE" ] && [ -z "$DIRTY" ] && exit 0

# Normal case: take the update.
if [ -z "$DIRTY" ] && as_lukas merge --ff-only --quiet origin/main 2>/dev/null; then
    AFTER=$(as_lukas rev-parse HEAD)
    if [ "$BEFORE" != "$AFTER" ]; then
        echo "updated ${BEFORE:0:7} -> ${AFTER:0:7}"
        # A checkout is not an install. campfire/ in that repo is the live
        # runtime -- bridge, commands, units, routes -- so put the new version
        # into service instead of waiting for the VM to be rebuilt.
        "$REPO/campfire/appsmoothly-install" || echo "install step failed" >&2
    fi
    exit 0
fi

# --- cannot fast-forward: ask in chat --------------------------------------
MARK="$STATE/last-asked"
if [ -f "$MARK" ] && [ $(( $(date +%s) - $(stat -c %Y "$MARK") )) -lt 21600 ]; then
    echo "cannot fast-forward; already asked in Campfire within 6h, not repeating"
    exit 0
fi

STATUS=$(as_lukas status --short | head -20)
LOCAL=$(as_lukas log --oneline "origin/main..HEAD" 2>/dev/null | head -10)

MSG="**The workspace repo could not update.**

\`/home/appsmoothly\` cannot fast-forward from \`origin/main\`.

Local status:
\`\`\`
${STATUS:-(clean)}
\`\`\`
Local commits not on origin:
\`\`\`
${LOCAL:-(none)}
\`\`\`

Claude — please sort this out. Get the working tree clean and HEAD matching
origin/main, without discarding anything that looks deliberate. Rebase genuine
local work onto origin/main and resolve conflicts favouring upstream for shared
files (CLAUDE.md, .claude/skills/, campfire/). Do not touch projects/, do not
push, do not force. Say what you did."

if ! printf '%s' "$MSG" | /usr/local/bin/notify --ask; then
    echo "could not post to Campfire; leaving the repo alone" >&2
    exit 0
fi

touch "$MARK"
echo "posted to #System and asked Claude to resolve it"

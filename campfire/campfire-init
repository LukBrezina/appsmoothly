#!/bin/bash
# First-boot: per-VM secrets and a running Campfire. Deliberately does NOT
# create an account -- you complete Campfire's own first-run in the browser, so
# the admin identity and password are yours, not invented here.
#
# The Claude bot cannot exist before an account does, so it is created
# afterwards by campfire-bot-init.timer, which waits for you.
set -euo pipefail
STATE=/var/lib/campfire-init
mkdir -p "$STATE" /etc/campfire
[ -f "$STATE/done" ] && exit 0

echo "==> generating per-VM secrets"
{
  echo "SECRET_KEY_BASE=$(openssl rand -hex 64)"
  python3 /opt/claude-bot/vapid-gen.py
} > /etc/campfire/env
chmod 600 /etc/campfire/env

# The bridge secret is needed now so the webhook URL is stable once the bot is
# created later.
openssl rand -hex 16 > "$STATE/bridge-secret"
chmod 600 "$STATE/bridge-secret"

echo "==> starting campfire"
systemctl start campfire
for i in $(seq 1 60); do
    curl -sf -o /dev/null http://127.0.0.1:8080/up 2>/dev/null && break
    sleep 3
done
curl -sf -o /dev/null http://127.0.0.1:8080/up || { echo "campfire did not become healthy" >&2; exit 1; }

systemctl start campfire-bot-init.timer
touch "$STATE/done"
echo "==> campfire is up and unconfigured; open it and complete first-run"

#!/bin/bash
# template-build [<git-url> | --base-only] -- build or refresh this cell's
# template container.
#
# The template is the one deterministic thing in the factory: a stopped
# container holding the project repo AT LATEST MAIN with its toolchain and
# dependencies installed, so that a run copied from it starts from current
# main in seconds instead of minutes of bundle install. Everything
# app-specific beyond that single rule -- seeding, snapshots, schedules -- is
# deliberately NOT here; that is the orchestrator's judgment, not config.
#
#   first call:   template-build https://github.com/you/yourapp.git
#   afterwards:   template-build          # refresh -- also what the timer runs
#   --base-only   just make sure the factory-base image exists (used when
#                 baking it into a golden image)
#
# The system layer -- build-essential and the libraries basically every Rails
# app needs, the dev user, mise, claude -- is built ONCE into a local image
# called factory-base, and every template build starts from that instead of
# from a vanilla Ubuntu. That turns the ~12 minutes of apt into a one-time
# cost per cell (and a zero cost once the base is baked into the golden
# image).
#
# The refresh path is cheap when nothing changed (a git fetch), and on a change
# it pulls, reinstalls deps and re-runs the repo's own `bin/setup`. A setup
# failure does not delete anything: the template stays on the previous working
# state of its checkout and the failure is posted to chat for the bot to look
# at. Idempotent; safe on every timer tick.
#
# The GitHub token pasted via `ask-secret GITHUB_TOKEN ...` is copied into the
# template so clones and fetches work. The claude OAuth token is NOT baked in
# anywhere here -- `run new` pushes it into each run, so neither the base
# image nor the template ever carries it.
set -euo pipefail

[ "$(id -u)" = 0 ] || { echo "template-build: run as root" >&2; exit 1; }
command -v incus >/dev/null 2>&1 || { echo "template-build: no incus -- run cell-init first" >&2; exit 1; }

STATE=/var/lib/factory
URL_FILE="$STATE/repo-url"
LOG="$STATE/template.log"
IMAGE="images:ubuntu/24.04"
BASE=factory-base
TOKEN_SRC=/home/lukas/.secrets/GITHUB_TOKEN

# Everything inside a container runs as this user; uid 1000 so the bridge can
# address it with a constant.
as_dev_in() { local c="$1"; shift; incus exec "$c" --user 1000 --group 1000 --env HOME=/home/dev "$@"; }
as_dev() { as_dev_in template "$@"; }
in_app() { as_dev --cwd /home/dev/app -- bash -lc "$1"; }

wait_ready() {  # <container> -> exec answers and DNS resolves
    local c="$1" i
    for i in $(seq 1 30); do incus exec "$c" -- true 2>/dev/null && break; sleep 1; done
    for i in $(seq 1 30); do incus exec "$c" -- getent hosts github.com >/dev/null 2>&1 && break; sleep 1; done
}

tell() {  # post to chat if the bot machinery is present; never fail the build
    sudo -u lukas /usr/local/bin/notify "$1" >/dev/null 2>&1 || true
}

# ------------------------------------------------------------ base image ---
ensure_base() {
    incus image info "$BASE" >/dev/null 2>&1 && return 0
    echo "==> building $BASE (once -- later template builds start from it)"
    incus delete base-builder --force 2>/dev/null || true
    incus launch "$IMAGE" base-builder >/dev/null
    wait_ready base-builder

    echo "  base system"
    incus exec base-builder -- bash -c '
        set -e
        apt-get update -qq
        DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
            git gh curl ca-certificates sudo tmux python3 build-essential pkg-config \
            libyaml-dev libssl-dev zlib1g-dev libffi-dev libpq-dev libsqlite3-dev \
            libvips >/dev/null
        # gh authenticates from GH_TOKEN; the run token is the natural value.
        cat > /etc/profile.d/gh-token.sh <<"EOF"
[ -r "$HOME/.secrets/GITHUB_TOKEN" ] && export GH_TOKEN="$(cat "$HOME/.secrets/GITHUB_TOKEN")"
EOF
        # The image may already ship a default user at uid 1000 (ubuntu/24.04
        # does: "ubuntu"). The bridge addresses the run user by uid, so 1000
        # is the contract -- take over whoever holds it. Every step tolerates
        # any half-state a previous attempt left behind: no -m home move (it
        # refuses if the target exists), ownership fixed explicitly instead.
        if ! getent passwd dev >/dev/null; then
            existing=$(getent passwd 1000 | cut -d: -f1 || true)
            if [ -n "$existing" ]; then
                usermod -l dev "$existing"
                groupmod -n dev "$existing" 2>/dev/null || true
            else
                useradd -u 1000 -s /bin/bash dev
            fi
        fi
        usermod -d /home/dev -s /bin/bash dev
        install -d /home/dev
        chown 1000:1000 /home/dev
        echo "dev ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/dev
        chmod 440 /etc/sudoers.d/dev
    '

    echo "  mise"
    as_dev_in base-builder -- bash -c 'command -v ~/.local/bin/mise >/dev/null 2>&1 || curl -fsSL https://mise.run | sh' >/dev/null
    # Shims first for ruby/node -- but ~/.local/bin goes LAST, or the raw
    # claude binary there shadows the /usr/local/bin/claude wrapper that
    # injects the OAuth token, and every claude call in a run is silently
    # unauthenticated.
    incus exec base-builder -- bash -c '
        cat > /etc/profile.d/mise-shims.sh <<EOF
export PATH="\$HOME/.local/share/mise/shims:\$PATH:\$HOME/.local/bin"
EOF
    '
    as_dev_in base-builder -- bash -lc 'mise settings set idiomatic_version_file_enable_tools ruby,node,python' >/dev/null 2>&1 || true

    echo "  claude"
    # A base without claude produces runs whose rooms die with exit 127 --
    # this happened, silently, behind a >/dev/null. Retry, then VERIFY, and
    # fail the whole base build rather than bake a broken image.
    as_dev_in base-builder -- bash -c '
        for i in 1 2 3; do
            curl -fsSL https://claude.ai/install.sh | bash >/dev/null 2>&1 && break
            sleep 5
        done
        test -x /home/dev/.local/bin/claude' || {
        echo "claude install failed three times; not publishing a broken base" >&2
        incus delete base-builder --force
        exit 1
    }
    # Same wrapper contract as the VM: the OAuth token lives root-owned in
    # /etc/claude (pushed per-run, never baked in) and ANTHROPIC_API_KEY must
    # never override it.
    incus exec base-builder -- bash -c '
        cat > /usr/local/bin/claude <<"EOF"
#!/bin/bash
unset ANTHROPIC_API_KEY
if [ -r /etc/claude/oauth-token ]; then
    CLAUDE_CODE_OAUTH_TOKEN="$(cat /etc/claude/oauth-token)"
elif sudo -n test -r /etc/claude/oauth-token 2>/dev/null; then
    CLAUDE_CODE_OAUTH_TOKEN="$(sudo -n cat /etc/claude/oauth-token)"
fi
export CLAUDE_CODE_OAUTH_TOKEN
exec "$HOME/.local/bin/claude" "$@"
EOF
        chmod 755 /usr/local/bin/claude
        install -d -m 700 /etc/claude
        echo "unset ANTHROPIC_API_KEY" > /etc/profile.d/00-anthropic-guard.sh
    '
    # Claude Code will not read the checkout's settings until the directory is
    # trusted, and there is nobody in a run to click a dialog -- the VM (not a
    # path inside a container) is the security boundary, same reasoning as
    # trust_dir in `room`. /home/dev/app is a constant, so this bakes cleanly.
    as_dev_in base-builder -- bash -c 'python3 - <<"PY"
import json, os
path = "/home/dev/.claude.json"
try:
    data = json.load(open(path))
except Exception:
    data = {}
entry = data.setdefault("projects", {}).setdefault("/home/dev/app", {})
entry["hasTrustDialogAccepted"] = True
data["bypassPermissionsModeAccepted"] = True
json.dump(data, open(path + ".tmp", "w"), indent=2)
os.replace(path + ".tmp", path)
PY' || true
    # The agent that later runs inside a run needs to know WHERE it is, or it
    # reinstalls toolchains that exist and builds worktrees it does not need
    # -- exactly what the first live run did. ~/.claude/CLAUDE.md is user-
    # level context, layered under the project's own CLAUDE.md.
    as_dev_in base-builder -- bash -c 'install -d -m 755 /home/dev/.claude && cat > /home/dev/.claude/CLAUDE.md <<"EOF"
# You are inside a factory run

This container is one disposable piece of work. The app lives at
/home/dev/app, already checked out on this run'"'"'s own branch, dependencies
installed. Messages reach you from the project'"'"'s chat; keep replies short
-- verdicts and links, not walls of text.

- ruby/node come from mise shims. They are on PATH in login shells; if a
  command cannot find ruby, run it as `bash -lc "..."` instead of
  installing anything.
- Work directly in /home/dev/app on the current branch. NO worktrees, no
  fresh clones -- this container IS the isolation; there is nothing to
  protect from yourself.
- Serve the app on 127.0.0.1:3000; that port is already wired to this
  run'"'"'s public preview URL.
- Commit and push as you go (the GitHub token is wired via the credential
  helper); open a PR when the work is ready.
- sudo works and the container is disposable: be bold in here, careful in
  git.
EOF'

    # The credential helper answers github.com https fetches with whatever
    # token a container carries; identical contract to the VM's own helper.
    incus file push /usr/local/bin/git-credential-appsmoothly base-builder/usr/local/bin/git-credential-appsmoothly \
        --mode 0755 --quiet 2>/dev/null || true
    as_dev_in base-builder -- bash -c 'git config --global credential.https://github.com.helper appsmoothly' 2>/dev/null || true

    incus stop base-builder
    incus publish base-builder --alias "$BASE" --quiet >/dev/null
    incus delete base-builder
    echo "  $BASE published"
}

if [ "${1:-}" = "--base-only" ]; then
    ensure_base
    exit 0
fi

URL="${1:-}"
if [ -z "$URL" ]; then
    [ -r "$URL_FILE" ] || { echo "usage: template-build <git-url>   (no repo recorded yet)" >&2; exit 1; }
    URL=$(cat "$URL_FILE")
else
    install -d -m 775 -g incus-admin "$STATE"
    printf '%s\n' "$URL" > "$URL_FILE"
fi

push_github_token() {
    [ -r "$TOKEN_SRC" ] || return 0
    incus exec template -- install -d -m 700 -o 1000 -g 1000 /home/dev/.secrets
    incus file push "$TOKEN_SRC" template/home/dev/.secrets/GITHUB_TOKEN \
        --mode 0600 --uid 1000 --gid 1000 --quiet
}

# Files the app needs in its checkout but that never enter git -- Rails
# config/master.key is the canonical case. Convention: a file at
# ~/.secrets/app-files/<path> lands in the template at /home/dev/app/<path>,
# so every run is born preconfigured and nothing has to be pasted per run.
# Returns 0 when something actually changed, so the caller knows to rerun
# the repo's setup.
APP_FILES=/home/lukas/.secrets/app-files
inject_app_files() {
    local changed=1 rel tmp
    [ -d "$APP_FILES" ] || return 1
    while IFS= read -r -d '' f; do
        rel="${f#"$APP_FILES"/}"
        tmp=$(mktemp)
        if incus file pull "template/home/dev/app/$rel" "$tmp" >/dev/null 2>&1 &&
           cmp -s "$tmp" "$f"; then
            rm -f "$tmp"; continue
        fi
        rm -f "$tmp"
        incus file push "$f" "template/home/dev/app/$rel" --create-dirs \
            --uid 1000 --gid 1000 --mode 0600 --quiet
        echo "  injected $rel"
        changed=0
    done < <(find "$APP_FILES" -type f -print0)
    return $changed
}

# ---------------------------------------------------------------- refresh ---
if incus info template >/dev/null 2>&1; then
    WAS_RUNNING=$(incus list template --format csv -c s)
    [ "$WAS_RUNNING" = "RUNNING" ] || incus start template
    wait_ready template

    push_github_token
    # The template never leaves the clone's default branch (main, master,
    # whatever the repo calls it) -- branches are cut in run copies, not here.
    # So a refresh is exactly a fast-forward pull.
    HEAD=$(in_app "git rev-parse HEAD" | tr -d '\r')
    if ! in_app "git pull --ff-only --quiet"; then
        echo "pull failed" >&2
        [ "$WAS_RUNNING" = "RUNNING" ] || incus stop template --force 2>/dev/null || true
        exit 1
    fi
    AFTER=$(in_app "git rev-parse HEAD" | tr -d '\r')
    FILES=1; inject_app_files && FILES=0
    if [ "$HEAD" = "$AFTER" ] && [ "$FILES" = 1 ]; then
        [ "$WAS_RUNNING" = "RUNNING" ] || incus stop template
        exit 0
    fi

    echo "template: ${HEAD:0:7} -> ${AFTER:0:7}$([ "$FILES" = 0 ] && echo ' + app files')"
    {
        in_app "mise install --quiet" &&
        in_app "[ ! -x bin/setup ] || bin/setup"
    } >"$LOG" 2>&1 || {
        tell "factory: template refresh to ${AFTER:0:7} pulled, but deps/setup failed -- see $LOG on the cell. New runs will carry that state until main (or the template) is fixed."
        echo "refresh setup failed at ${AFTER:0:7} (log: $LOG)" >&2
        [ "$WAS_RUNNING" = "RUNNING" ] || incus stop template --force
        exit 1
    }
    [ "$WAS_RUNNING" = "RUNNING" ] || incus stop template
    echo "template now at ${AFTER:0:7}"
    exit 0
fi

# ------------------------------------------------------------------ build ---
ensure_base

echo "==> launching template from $BASE"
incus launch "$BASE" template >/dev/null
wait_ready template

echo "==> repo"
push_github_token
as_dev -- git clone "$URL" /home/dev/app || {
    tell "factory: could not clone $URL into the template. If it is private, paste a token with: ask-secret GITHUB_TOKEN \"to clone the project into the factory template\" and rerun template-build."
    echo "clone failed -- is a GITHUB_TOKEN needed? (ask-secret GITHUB_TOKEN ...)" >&2
    exit 1
}

inject_app_files || true

echo "==> toolchain + deps (the slow part, once per project)"
in_app "mise install" || echo "  WARN: mise install had errors" >&2
if ! in_app "[ ! -x bin/setup ] || bin/setup" >"$LOG" 2>&1; then
    tell "factory: template built, but the repo's bin/setup failed -- the app side needs a look before runs are useful. Log tail follows."
    tail -5 "$LOG" | while read -r l; do tell "  $l"; done
    echo "  WARN: bin/setup failed (log: $LOG) -- template usable for code work, app may need attention" >&2
fi

incus stop template
echo "template built from $URL -- runs can now be created with: run new <name>"

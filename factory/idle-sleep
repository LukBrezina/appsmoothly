#!/bin/bash
# idle-sleep -- put factory runs to sleep when nobody is using them.
#
# A run is "in use" when its claude agent is doing something inside it, or
# when something holds a connection to its preview port (an open browser tab
# keeps its websocket up, so watching the app counts as using it). A run that
# is idle on two consecutive ticks -- ~30 minutes -- is FROZEN: every process
# kept mid-flight, so waking is a sub-second unfreeze with nothing to boot
# and no unit to depend on. Frozen memory is idle and the kernel can swap
# it. It wakes on a room message or a preview visit.
#
# The template is never touched; it is stopped by template-build itself.
# Runs the timer fires every 15 minutes; safe to run by hand.
set -uo pipefail

REG=/var/lib/factory/runs.tsv
STRIKES=/var/lib/factory/idle.strikes    # name<TAB>count
[ -r "$REG" ] || exit 0
command -v incus >/dev/null 2>&1 || exit 0
touch "$STRIKES" 2>/dev/null || exit 0

get_strikes() { awk -F'\t' -v n="$1" '$1==n{print $2}' "$STRIKES" | head -1; }
set_strikes() {
    awk -F'\t' -v n="$1" '$1!=n' "$STRIKES" > "$STRIKES.tmp"
    [ "$2" != 0 ] && printf '%s\t%s\n' "$1" "$2" >> "$STRIKES.tmp"
    mv "$STRIKES.tmp" "$STRIKES"
}

tell() { sudo -u lukas /usr/local/bin/notify "$1" >/dev/null 2>&1 || true; }

while IFS=$'\t' read -r name port _branch; do
    [ -n "$name" ] || continue
    S=$(incus list "run-$name" --format csv -c s 2>/dev/null | head -1)
    [ "$S" = "RUNNING" ] || { set_strikes "$name" 0; continue; }

    busy=""
    # The agent is working inside it.
    incus exec "run-$name" -- pgrep -u 1000 -f claude >/dev/null 2>&1 && busy=agent
    # Someone is connected to the preview (an open tab holds its websocket).
    [ -z "$busy" ] && ss -Htn state established "( sport = :$port )" 2>/dev/null | grep -q . && busy=viewer

    if [ -n "$busy" ]; then
        set_strikes "$name" 0
        continue
    fi

    N=$(( $(get_strikes "$name" 2>/dev/null || echo 0) + 1 ))
    if [ "$N" -ge 2 ]; then
        incus freeze "run-$name" 2>/dev/null
        set_strikes "$name" 0
        echo "run-$name frozen (idle)"
        tell "run-$name fell asleep after being idle (frozen mid-flight -- nothing lost). A message in its room or opening its preview URL wakes it in about a second."
    else
        set_strikes "$name" "$N"
    fi
done < "$REG"
